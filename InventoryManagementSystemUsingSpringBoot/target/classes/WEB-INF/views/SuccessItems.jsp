<!DOCTYPE html>
<html>
<head>
    <title>Document</title>

    <style>
        .container {
            margin: 40px auto;
            width: 500px;
            height: 120px;
            border-radius: 30px;
            box-shadow: 0px 0px 15px black;
            text-align: center;
            padding: 30px;
            background-color: darkslategray;
            color: wheat;
        }

        .container h1 {
            letter-spacing: 5px;
        }

        .container a {
            font-size: 25px;
            letter-spacing: 3px;
            font-style: italic;
            font-family: cursive;
            color: white;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Item added successfully!!</h1>
        <a href="/">Add New Item</a>
    </div>
</body>
</html>